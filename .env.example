PORT=3000

# Cadena de conexion de Supabase (Settings -> Database -> Connection string -> URI, modo Session pooler)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Clave para firmar los tokens de sesion (generar una propia, no reusar esta)
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Origen permitido para las cookies de sesion (el frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Fotos/logos en Supabase Storage (opcional, ver server/storage.js)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# Monitoreo de errores (Sentry) - opcional, dejar vacio si no se usa
SENTRY_DSN=
